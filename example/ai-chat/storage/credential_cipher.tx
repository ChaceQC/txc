import "crypto.txh" as crypto
import "bytes.txh" as byte_values
import "encoding.txh" as encoding
import "file.txh" as file
import "fs.txh" as fs
import "path.txh" as path
import "error.txh" as errors

class credential_cipher
{
    private:
        filename: str
        def transform(value: str, decrypt: bool) -> str
        {
            if value == ""
            {
                return ""
            }
            str key_file = path.join(path.parent(self.filename), "settings.key")
            if !fs.exists(key_file)
            {
                if decrypt
                {
                    errors.fail_io("credential_key_missing", "本地加密密钥文件缺失，请恢复 settings.key。")
                }
                fs.create_directories(path.parent(self.filename))
                file.atomic_write_bytes(key_file, crypto.generate_key())
            }
            if fs.file_size(key_file) != 32
            {
                errors.fail_io("credential_key_invalid", "本地加密密钥文件格式无效。")
            }
            bytes key = file.read_bytes(key_file)
            bytes aad = encoding.encode("tx-chat:api-key:v2", "utf-8")
            if decrypt
            {
                return encoding.decode(crypto.decrypt(key, byte_values.from_base64(value), aad), "utf-8")
            }
            return byte_values.to_base64(crypto.encrypt(key, encoding.encode(value, "utf-8"), aad))
        }
    public:
        def init(filename: str)
        {
            self.filename = filename
        }
        def encrypt(value: str) -> str
        {
            return self.transform(value, false)
        }
        def decrypt(value: str) -> str
        {
            return self.transform(value, true)
        }
}
