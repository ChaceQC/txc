import "test.txh" as test
import "log.txh" as log
import "time.txh" as time
import "file.txh" as file
import "string.txh" as string

def parameter(total: vector<int>, index: int)
{
    total[0] += index
}

def generate(seed: int, index: int) -> int
{
    return seed + index
}

def predicate(total: vector<int>, value: int) -> bool
{
    total[0] += 1
    return value >= 1000
}

def shrink(value: int) -> int
{
    return value / 2
}

def lazy_fields() -> dict
{
    return {"index": 42}
}

def main() -> int
{
    auto total = vector<int>([0])
    auto start = time.monotonic_micros()
    test.parameterized("bench", 20000, bind(parameter, total))
    print("test_parameterized", time.monotonic_micros() - start, total[0])
    total[0] = 0
    start = time.monotonic_micros()
    test.property("bench", 1000, 20000, generate, bind(predicate, total), shrink)
    print("test_property", time.monotonic_micros() - start, total[0])
    log.set_level("info")
    start = time.monotonic_micros()
    for i in 1..=100000
    {
        log.event_lazy("debug", "filtered", lazy_fields)
    }
    print("log_filtered", time.monotonic_micros() - start, 100000)
    log.set_file("events.jsonl", 10485760, 2)
    log.set_request_context("bench")
    start = time.monotonic_micros()
    for i in 1..=2000
    {
        log.event("info", "entry", {"index": i, "password": "synthetic"})
    }
    log.flush()
    auto elapsed = time.monotonic_micros() - start
    log.set_stderr()
    auto content = file.read_text("events.jsonl", "utf-8")
    print("log_file", elapsed, len(string.split(content, "\n")) - 1)
    return 0
}
