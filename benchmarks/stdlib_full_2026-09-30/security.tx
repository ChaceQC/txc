import "time.txh" as time
import "bytes.txh" as bytes
import "file.txh" as file
import "secret.txh" as secret
import "password.txh" as password
import "public_key.txh" as public_key
import "x509.txh" as x509

def main() -> int
{
    auto data = file.read_bytes("message.bin")
    auto first = secret.from_bytes(data)
    auto second = secret.from_bytes(data)
    auto total = 0
    auto start = time.monotonic_micros()
    for i in 1..=20000
    {
        if secret.equal(first, second)
        {
            total += 1
        }
    }
    print("secret_equal", time.monotonic_micros() - start, total)
    auto credential = secret.from_bytes(file.read_bytes("password.bin"))
    start = time.monotonic_micros()
    total = 0
    for i in 1..=3
    {
        auto hashed = password.hash_password_with_params(credential, 19456, 2, 1)
        if password.verify_password(credential, hashed)
        {
            total += 1
        }
    }
    print("argon2_hash_verify", time.monotonic_micros() - start, total)
    auto key = public_key.ed25519_import_seed(file.read_bytes("ed_seed.bin"))
    auto pub = public_key.ed25519_public(key)
    auto signature = public_key.ed25519_sign(key, data)
    start = time.monotonic_micros()
    total = 0
    for i in 1..=500
    {
        signature = public_key.ed25519_sign(key, data)
        total += len(signature)
    }
    print("ed25519_sign", time.monotonic_micros() - start, total)
    start = time.monotonic_micros()
    total = 0
    for i in 1..=500
    {
        if public_key.ed25519_verify(pub, data, signature)
        {
            total += 1
        }
    }
    print("ed25519_verify", time.monotonic_micros() - start, total)
    auto cert = file.read_bytes("server.der")
    start = time.monotonic_micros()
    total = 0
    for i in 1..=500
    {
        total += len(x509.parse_der(cert))
    }
    print("x509_parse_der", time.monotonic_micros() - start, total)
    secret.close(first)
    secret.close(second)
    secret.close(credential)
    secret.close(key)
    return 0
}
