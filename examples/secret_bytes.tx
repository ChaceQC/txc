import "bytes.txh" as byte_values
import "secret.txh" as secret

def main() -> int
{
    secret_bytes key = secret.random(32)
    secret_bytes alias = key
    if secret.size(alias) != 32 || !secret.equal(key, alias)
    {
        return 1
    }
    bytes exported = secret.to_bytes(key)
    if len(exported) != 32
    {
        return 2
    }
    secret.close(key)
    secret.close(alias)
    print("秘密字节示例通过")
    return 0
}
