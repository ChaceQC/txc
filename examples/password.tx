import "encoding.txh" as encoding
import "password.txh" as password
import "secret.txh" as secret

def main() -> int
{
    secret_bytes phrase = secret.from_bytes(encoding.encode("示例口令", "utf-8"))
    secret_bytes wrong = secret.from_bytes(encoding.encode("其他口令", "utf-8"))
    str stored = password.hash_password(phrase)
    if !password.verify_password(phrase, stored) || password.verify_password(wrong, stored)
    {
        return 1
    }
    if password.needs_rehash(stored, 65536, 3, 1)
    {
        return 2
    }
    secret.close(phrase)
    secret.close(wrong)
    print("密码哈希示例通过")
    return 0
}
