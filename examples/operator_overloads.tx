struct point
{
    x: int
    y: int

    def operator +(other: point) -> point
    {
        return point(self.x + other.x, self.y + other.y)
    }

    def operator -(other: point) -> point
    {
        return point(self.x - other.x, self.y - other.y)
    }

    def operator -() -> point
    {
        return point(-self.x, -self.y)
    }

    def operator ==(other: point) -> bool
    {
        return self.x == other.x && self.y == other.y
    }

    def operator !=(other: point) -> bool
    {
        return !(self == other)
    }

    def operator *(factor: int) -> point
    {
        return point(self.x * factor, self.y * factor)
    }

    def operator <(other: point) -> bool
    {
        return self.x < other.x
    }

    def operator !() -> bool
    {
        return self.x == 0 && self.y == 0
    }
}

struct point_holder
{
    position: point
}

class counter
{
    private:
        value: int
    public:
        def init(value: int)
        {
            self.value = value
        }

        def get() -> int
        {
            return self.value
        }

        virtual def operator +(other: counter) -> counter
        {
            return counter(self.value + other.value)
        }
}

class bonus_counter : counter
{
    public:
        override def operator +(other: counter) -> counter
        {
            counter base_sum = super + other
            return counter(base_sum.get() + 100)
        }
}

def main() -> int
{
    auto first = point(4, 6)
    first += point(2, 1)
    auto difference = first - point(1, 2)
    auto negative = -difference
    if first != point(6, 7) || negative.x != -5 || negative.y != -5
    {
        return 1
    }
    auto doubled = first * 2
    if doubled.x != 12 || doubled.y != 14 || !(point(1, 0) < point(2, 0))
    {
        return 4
    }
    auto holder = point_holder(point(1, 2))
    holder.position += point(2, 3)
    if holder.position != point(3, 5)
    {
        return 5
    }
    if !point(0, 0) != true
    {
        return 2
    }

    counter left = bonus_counter(2)
    counter right = counter(3)
    counter sum = left + right
    if sum.get() != 105
    {
        return 3
    }
    left += right
    if left.get() != 105
    {
        return 6
    }
    return 0
}
