# 整数取余与乘除同级，连续运算从左到右结合。
def main() -> int
{
    if (7 % 3 != 1 || -7 % 3 != -1 ||
        7 % -3 != 1 || -7 % -3 != -1)
    {
        return 1
    }
    if 0 % 3 != 0 || -9223372036854775808 % -1 != 0
    {
        return 2
    }
    if 2 + 9 % 4 * 3 != 5
    {
        return 3
    }
    return 0
}
