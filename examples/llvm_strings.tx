struct counter
{
    value: int
}

def greet(name: str) -> str
{
    auto prefix = "你好，"
    return prefix + name
}

def main() -> int
{
    str name = "Ada"
    print(greet(name))
    name += "!"
    if name == "Ada!"
    {
        print(len(name))
    }
    for i in 1..=3
    {
        auto text = "loop"
        print(text)
    }
    auto total = counter(1)
    total.value += 2
    print(total.value)
    return 0
}
