def factorial(n: int) -> int
{
    if n <= 1
    {
        return 1
    }
    return n * factorial(n - 1)
}

def is_even(n: int) -> bool
{
    if n == 0
    {
        return true
    }
    return is_odd(n - 1)
}

def is_odd(n: int) -> bool
{
    if n == 0
    {
        return false
    }
    return is_even(n - 1)
}

def countdown(n: int)
{
    if n <= 0
    {
        return
    }
    print(n)
    countdown(n - 1)
}

def main() -> int
{
    if factorial(5) != 120
    {
        return 1
    }
    if !is_even(10) || !is_odd(7)
    {
        return 2
    }
    countdown(3)
    return 0
}
