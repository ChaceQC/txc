# deinit 把对象放回可达的 keeper 后，回收器必须保留该对象。
class keeper
{
    public:
        saved: victim
}

class victim
{
    public:
        anchor: keeper
        next: victim
        value: int

        def init(anchor: keeper)
        {
            self.anchor = anchor
            self.value = 7
        }

        def deinit()
        {
            self.anchor.saved = self
            print("victim deinit")
        }
}

def make_cycle(target: keeper)
{
    victim item = victim(target)
    item.next = item
}

def main() -> int
{
    keeper root = keeper()
    make_cycle(root)
    for index in 0..=70
    {
        # 复合值数组保持真实分配，避免局部标量数组优化消去回收触发条件。
        array step = [root]
    }
    print(root.saved.value)
    return 0
}
