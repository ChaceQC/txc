import "../modules/overload.txh" as math

def describe() -> str {
    return "无参数"
}

def describe(value: int) -> str {
    return "int: " + (value as str)
}

def describe(value: float) -> str {
    return "float: " + (value as str)
}

def main() -> int {
    print(describe())
    print(describe(math.twice(3)))
    print(describe(math.twice(2.5)))
    return 0
}
