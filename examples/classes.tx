# class 是引用类型；父类引用的虚调用会进入子类实现。
class animal {
    private:
        id: int
    protected:
        name: str
    public:
        def init(name: str, id: int) {
            self.name = name
            self.id = id
        }
        virtual def speak() -> str {
            return self.name
        }
        def badge() -> str {
            return self.speak() + ":" + (self.id as str)
        }
        def rename(value: str) {
            self.name = value
        }
}

class dog : animal {
    private:
        breed: str
    public:
        def init(name: str, id: int, breed: str) {
            super.init(name, id)
            self.breed = breed
        }
        override def speak() -> str {
            return super.speak() + " 汪"
        }
        def breed_name() -> str {
            return self.breed
        }
}

class collector {
    public:
        values: array
        def init(*items) {
            self.values = items
        }
        def count() -> int {
            return len(self.values)
        }
}

def identify(value: animal) -> str {
    return "animal:" + value.speak()
}

def identify(value: dog) -> str {
    return "dog:" + value.speak()
}

def main() -> int {
    dog actual = dog(name="豆豆", id=7, breed="柴犬")
    animal base = actual
    actual.rename("球球")
    print(base.speak())
    print(base.badge())
    print(identify(actual))
    print(identify(base))
    print(actual.breed_name())
    print(actual)
    collector group = collector(1, 2, 3)
    print(group.count())
    return 0
}
