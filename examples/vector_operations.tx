import "vector_module/values.txh" as module
import "string.txh"

class box
{
    public:
        items: vector<str>
}

def main() -> int
{
    auto fs = module.make()
    fs.first[module.grow(fs.first)] = 6
    print(len(fs.second) == 1024 && fs.second[0] == 6)
    fs.first[0] = module.replace(fs)
    print(fs.first[0] == 20 && fs.second[0] == 8)

    auto copied = deep_copy(fs)
    copied.second[0] = 7
    print(fs.second[0] == 8 && copied.second[0] == 7)
    fs.first = fs.second
    copied = deep_copy(fs)
    copied.first[0] = 3
    print(copied.second[0] == 3 && fs.first[0] == 8)

    vector<int> ids = vector<int>([1, 2, 3])
    ids.reserve(16)
    print(ids.capacity() >= 16 && ids.size() == 3)
    ids.insert(1, 5)
    ids.erase(0)
    ids.push_back(8)
    ids.pop_back()
    ids[0] += 2
    ids[1]++
    ids[2] -= 1
    print(ids[0] == 7 && ids[1] == 3 && ids[2] == 2)
    int sum = 0
    for value in ids
    {
        sum += value
        ids.push_back(value)
    }
    print(sum == 12 && len(ids) == 6)
    ids.resize(2, 0)
    auto dynamic = ids.to_array()
    vector<int> restored = vector<int>(dynamic)
    print(restored[0] == 7 && restored[1] == 3)
    array wrapped = [ids]
    auto unwrapped = wrapped[0] as vector<int>
    unwrapped[0] = 11
    print(ids[0] == 11 && len(wrapped[0]) == 2)

    vector<float> decimals = vector<float>(2, 1.5)
    decimals[0] += 2.0
    decimals[1]++
    print(decimals[0] == 3.5 && decimals[1] == 2.5)
    vector<bool> flags = vector<bool>(2, false)
    flags[0] = true
    flags.push_back(true)
    print(flags[0] && !flags[1] && flags[2])

    vector<str> texts = split_vector("你好//world/", "/")
    str kept = texts[0]
    texts.push_back(texts[0])
    texts[1] = texts[1]
    texts[1] += "x"
    print(join(texts, "|") == "你好|x|world||你好")
    auto text_copy = deep_copy(texts)
    texts.clear()
    print(kept == "你好" && text_copy[0] == "你好")
    box container = box()
    container.items.push_back(kept)
    print(container.items[0] == "你好")
    print(vector<int>().size() == 0 && vector<str>().size() == 0)
    return 0
}
