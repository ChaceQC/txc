def sort(values: vector<int>) -> void
def sorted(values: vector<int>) -> vector<int>
def find(values: vector<int>, value: int) -> int
def count(values: vector<int>, value: int) -> int
def lower_bound(values: vector<int>, value: int) -> int
def upper_bound(values: vector<int>, value: int) -> int
def reverse(values: vector<int>) -> void
def sum(values: vector<int>) -> int
def min_element(values: vector<int>) -> int
def max_element(values: vector<int>) -> int

def sort(values: vector<float>) -> void
def sorted(values: vector<float>) -> vector<float>
def find(values: vector<float>, value: float) -> int
def count(values: vector<float>, value: float) -> int
def lower_bound(values: vector<float>, value: float) -> int
def upper_bound(values: vector<float>, value: float) -> int
def reverse(values: vector<float>) -> void
def sum(values: vector<float>) -> float
def min_element(values: vector<float>) -> float
def max_element(values: vector<float>) -> float

def sort(values: vector<str>) -> void
def sorted(values: vector<str>) -> vector<str>
def find(values: vector<str>, value: str) -> int
def count(values: vector<str>, value: str) -> int
def lower_bound(values: vector<str>, value: str) -> int
def upper_bound(values: vector<str>, value: str) -> int
def reverse(values: vector<str>) -> void

def find(values: vector<bool>, value: bool) -> int
def count(values: vector<bool>, value: bool) -> int
def reverse(values: vector<bool>) -> void

def stable_sort<T>(values: vector<T>) -> void
def stable_sort<T>(values: vector<T>, compare: fn(T,T)->int) -> void
def stable_sorted<T>(values: vector<T>) -> vector<T>
def stable_sorted<T>(values: vector<T>, compare: fn(T,T)->int) -> vector<T>
def binary_search<T>(values: vector<T>, key: T) -> option<int>
def binary_search<T>(values: vector<T>, key: T, compare: fn(T,T)->int) -> option<int>
def equal_range<T>(values: vector<T>, key: T) -> vector<int>
def equal_range<T>(values: vector<T>, key: T, compare: fn(T,T)->int) -> vector<int>
def unique<T>(values: vector<T>) -> int
def unique<T>(values: vector<T>, compare: fn(T,T)->int) -> int
def rotate<T>(values: vector<T>, middle: int) -> void
def partition<T>(values: vector<T>, predicate: fn(T)->bool) -> int
def map<T,U>(values: vector<T>, transform: fn(T)->U) -> vector<U>
def filter<T>(values: vector<T>, predicate: fn(T)->bool) -> vector<T>
def fold<T,U>(values: vector<T>, initial: U, combine: fn(U,T)->U) -> U
def all<T>(values: vector<T>, predicate: fn(T)->bool) -> bool
def any<T>(values: vector<T>, predicate: fn(T)->bool) -> bool
