# 数据模型按批次校验并提交；ID 是正整数，树根 parent_id 为 0。
struct list_item
{
    id: int
    text: str
}
struct table_column
{
    id: int
    title: str
    width: float
    alignment: str
    visible: bool
}
struct table_row
{
    id: int
    cells: vector<str>
}
struct tree_item
{
    id: int
    parent_id: int
    text: str
    has_children: bool
}

