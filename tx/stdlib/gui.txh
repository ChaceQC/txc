def set_height(control: gui_button, value: length) -> void
def set_constraints(control: gui_button, min_width: float, min_height: float, max_width: float, max_height: float) -> void
def set_margin(control: gui_button, margin: float) -> void
def set_alignment(control: gui_button, horizontal: str, vertical: str) -> void
def set_cell(control: gui_button, row: int, column: int, row_span: int, column_span: int) -> void
def set_text(control: gui_button, text: str) -> void
def text(control: gui_button) -> str
def focus(control: gui_button) -> result<void>

