# Windows GUI U0–U1；图形事件与窗口由唯一图形会话管理。
# U2–U3 扩展；完整契约见 docs/gui_u2_u3.md。

struct key_chord
{
    key: str
    ctrl: bool
    alt: bool
    shift: bool
    win: bool
}
struct file_filter
{
    name: str
    extensions: vector<str>
}
def create_command(window: graphics_window, text: str) -> result<gui_command>
def bind_button(button: gui_button, command: gui_command) -> void
def set_shortcut(command: gui_command, chord: key_chord) -> void
def clear_shortcut(command: gui_command) -> void
def create_menu(window: graphics_window) -> result<gui_menu>
def add_menu(parent: gui_menu, text: str) -> result<gui_menu>
def add_command(menu: gui_menu, command: gui_command) -> void
