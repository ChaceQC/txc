def show_modal(child: graphics_window, owner: graphics_window) -> result<void>
def open_file(window: graphics_window, title: str, filters: vector<file_filter>) -> result<option<str>>
def open_files(window: graphics_window, title: str, filters: vector<file_filter>) -> result<option<vector<str>>>
def save_file(window: graphics_window, title: str, filters: vector<file_filter>, extension: str) -> result<option<str>>
def pick_folder(window: graphics_window, title: str) -> result<option<str>>
def message_box(window: graphics_window, title: str, text: str, buttons: str) -> result<str>
def clipboard_text(window: graphics_window) -> result<option<str>>
def set_clipboard_text(window: graphics_window, text: str) -> result<void>
