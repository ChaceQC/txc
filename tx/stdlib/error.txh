struct error_info
{
    kind: str
    code: str
    message: str
}

def stack_trace() -> str

struct runtime_error
{
    kind: str
    code: str
    message: str
}

struct parse_error
{
    kind: str
    code: str
    message: str
}

struct io_error
{
    kind: str
    code: str
    message: str
}

struct process_error
{
    kind: str
    code: str
    message: str
}

struct database_error
{
    kind: str
    code: str
    message: str
}

struct security_error
{
    kind: str
    code: str
    message: str
}

struct cancelled_error
{
    kind: str
    code: str
    message: str
}

struct int_result
{
    ok: bool
    value: int
    error: error_info
}

struct graphics_error
{
    kind: str
    code: str
    message: str
}

struct float_result
{
    ok: bool
    value: float
    error: error_info
}

struct str_result
{
    ok: bool
    value: str
    error: error_info
}

struct bool_result
{
    ok: bool
    value: bool
    error: error_info
}

struct any_result
{
    ok: bool
    value: any
    error: error_info
}

def fail_io(code: str, message: str) -> void
