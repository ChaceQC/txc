import "error.txh" as errors

def read_text(path: str, encoding: str) -> str
def write_text(path: str, text: str, encoding: str) -> void
def append_text(path: str, text: str, encoding: str)

def try_read_text(path: str, encoding: str) -> errors.str_result
def try_write_text(path: str, text: str, encoding: str) -> errors.bool_result
def try_append_text(path: str, text: str, encoding: str) -> errors.bool_result

def read_bytes(path: str) -> bytes
def write_bytes(path: str, data: bytes) -> void
def atomic_write_bytes(path: str, data: bytes) -> void
def atomic_write_text(path: str, text: str, encoding: str) -> void
