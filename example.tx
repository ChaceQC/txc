def parse_error_demo()
{
    auto result = parse.try_parse_int("7f", 16)
    if result.ok
    {
        print("解析结果", result.value)
    }
    try
    {
        print(parse.parse_float("invalid"))
    }
    exception errors.parse_error as e
    {
        print("已处理解析错误", e.code, e.message)
    }
    print("异常处理后继续")
}

struct record
{
    name: str
    scores: array
    meta: dict
}

# struct 可声明运算符及 hash_key 成员；self 是隐含的接收者。
struct vector2
{
    x: int
    y: int

    def operator +(other: vector2) -> vector2
    {
        return vector2(self.x + other.x, self.y + other.y)
    }

    def operator -() -> vector2
    {
        return vector2(-self.x, -self.y)
    }

    def operator ==(other: vector2) -> bool
    {
        return self.x == other.x && self.y == other.y
    }
}

# 接口只声明方法；抽象类保留待子类实现的 speak。
interface labeled
{
    def label() -> str
}

abstract class animal : labeled
{
    protected:
        name: str
    public:
        def init(name: str)
        {
            self.name = name
        }
        abstract def speak() -> str
        override def label() -> str
        {
            return self.name + ":" + self.speak()
        }
        def deinit()
        {
            print("animal deinit")
        }
}

class counted
{
    protected:
        count: int
    public:
        virtual def count_value() -> int
        {
            return self.count
        }
        virtual def operator +(other: counted) -> int
        {
            return self.count + other.count
        }
        def deinit()
        {
            print("counted deinit")
        }
}

# 多继承、虚方法覆盖、同名方法重载和各层析构。
class dog : animal, counted
{
    public:
        def init(name: str, count: int)
        {
            super.init(name)
            self.count = count
        }
        override def speak() -> str
        {
            return self.name + " 汪"
        }
        override def count_value() -> int
        {
            return super(counted).count_value()
        }
        override def operator +(other: counted) -> int
        {
            return super(counted) + other
        }
        def describe(value: int) -> str
        {
            return "int=" + (value as str)
        }
        def describe(value: str) -> str
        {
            return "str=" + value
        }
        def deinit()
        {
            print("dog deinit")
        }
}

def class_demo()
{
    dog concrete = dog("豆豆", 2)
    labeled pet = concrete
    animal parent = concrete
    print(pet.label())
    print(parent.speak())
    print(concrete.describe(1))
    print(concrete.describe("好"))
    # as 在运行时确认实际对象类型，也可跨父类转换。
    dog recovered = pet as dog
    counted other_parent = pet as counted
    print(recovered.speak())
    print(other_parent.count_value())
    # 静态类型决定重载；运行时分派到 dog 的 override。
    counted left_counted = concrete
    print(left_counted + other_parent)
    # 离开函数时最后一个对象引用释放，依次执行 dog、counted、animal 的 deinit。
}

def sum_to(n: int) -> int
{
    int total = 0
    for i in 1..=n
    {
        total += i
    }
    return total
}

def factorial(n: int) -> int
{
    if n <= 1
    {
        return 1
    }
    return n * factorial(n - 1)
}

def describe(value: int) -> str
{
    return "int=" + (value as str)
}

def describe(value: float) -> str
{
    return "float=" + (value as str)
}

def write_message(message: str)
{
    print(message)
}

def stop_early(done: bool) -> void
{
    if done
    {
        return
    }
    print("未结束")
}

def show(label: str, *args, **kwargs)
{
    print(label)
    for value in args
    {
        print(value)
    }
    print(kwargs["status"])
}

def count_extra(*args: array, **kwargs: dict) -> int
{
    return len(args) + len(kwargs)
}

def empty_key(value: none) -> none
{
    return value
}

def container_library_demo()
{
    array values = [1, "二"]
    array shared = values
    arrays.push_back(values, true)
    arrays.insert(values, 1, none)
    arrays.erase(values, 0)
    arrays.pop_back(values)
    print("数组共享：", shared)

    # none 是合法键；items 一次取得配对快照，复合值继续共享。
    dict entries = {none: "空键", "nested": values}
    print("空键：", dictionary.get(entries, empty_key(none)))
    print("空键存在：", dictionary.contains(entries, none))
    array pairs = dictionary.items(entries)
    print("删除空键：", dictionary.remove(entries, none))
    dictionary.clear(entries)
    arrays.clear(values)
    print("清空后快照：", pairs)

    # 遍历记录初始长度，本次循环不会读取新追加的元素。
    array numbers = [1, 2]
    for value in numbers
    {
        arrays.push_back(numbers, value)
    }
    print("遍历追加：", numbers)
}

def typed_container_demo()
{
    # 内置类型化容器无需 import，键和值在编译期检查。
    map<str, int> counts = map<str, int>()
    counts["apple"] = 2
    counts["apple"] += 1
    print("类型化 map：", counts["apple"], counts.get("pear", 0), counts.contains("apple"))
    auto shared = counts
    auto copied = deep_copy(counts)
    shared["apple"]++
    print("map 共享与复制：", counts["apple"], copied["apple"])

    set<str> visited = set<str>()
    print("set 去重：", visited.insert("上海"), visited.insert("上海"))
    # 遍历使用快照，清空共享容器不会中断当前遍历。
    for city in visited
    {
        visited.clear()
        print("set 快照遍历：", city)
    }

    auto smallest = heap<int>()
    smallest.push(8)
    smallest.push(2)
    smallest.push(5)
    print("小顶堆顺序：", smallest.to_vector())
    smallest.pop()
    print("删除后的堆顶：", smallest.top())
    auto largest = heap<int>(true)
    largest.push(8)
    largest.push(2)
    print("大顶堆堆顶：", largest.top())

    queue<str> jobs = queue<str>()
    jobs.push("first")
    jobs.push("second")
    print("队首与队尾：", jobs.front(), jobs.back())
    for job in jobs
    {
        jobs.pop()
        print("FIFO 出队：", job)
    }
    print("队列已空：", jobs.empty(), len(jobs))
    array boxed = [counts]
    auto restored = boxed[0] as map<str, int>
    print("any 恢复 map：", restored["apple"])
}

def algorithm_demo()
{
    auto numbers = vector<int>([4, 1, 4, 2])
    auto shared = numbers
    auto ordered = algorithm.sorted(numbers)
    print("排序副本：", numbers, ordered)
    # 原地排序和反转通过共享引用生效，ordered 保持独立。
    algorithm.sort(numbers)
    print("原地排序：", shared)
    print("查找与计数：", algorithm.find(numbers, 4), algorithm.count(numbers, 4))
    print("二分边界：", algorithm.lower_bound(numbers, 4), algorithm.upper_bound(numbers, 4))
    print("整数统计：", algorithm.sum(numbers), algorithm.min_element(numbers), algorithm.max_element(numbers))
    algorithm.reverse(numbers)
    print("原地反转：", shared, ordered)

    auto decimals = vector<float>([2.5, -1.0, 2.5])
    print("浮点统计：", algorithm.sum(decimals), algorithm.min_element(decimals), algorithm.max_element(decimals))
    auto words = vector<str>(["梨", "apple", "香蕉", "apple"])
    print("字符串排序：", algorithm.sorted(words))
    auto flags = vector<bool>([true, false, false])
    algorithm.reverse(flags)
    print("布尔查找：", flags, algorithm.find(flags, true), algorithm.count(flags, false))

    # 已有容器可通过类型化快照交给算法，快照排序不修改 map。
    map<str, int> scores = map<str, int>()
    scores["bob"] = 80
    scores["alice"] = 95
    print("map 快照算法：", algorithm.sorted(scores.keys()), algorithm.sum(scores.values()))
}

def filesystem_library_demo() -> bool
{
    # 仅操作新建的示例目录，结束时删除；同名目录已存在则退出。
    str root = path.join("tx_build", "example_interfaces_" + (time.unix_millis() as str))
    if fs.exists(root)
    {
        print("示例目录已存在：", root)
        return false
    }
    fs.create_directories(path.join(root, "子目录"))
    str source = path.join(root, "原文.txt")
    str copied = path.join(root, "副本.txt")
    str moved = path.join(root, "子目录/移动.txt")
    file.write_text(source, "你好\n", "utf-8")
    fs.copy_file(source, copied, false)
    fs.rename(copied, moved)
    print("文件大小：", fs.file_size(moved))
    print("修改时间：", fs.modified_millis(moved))
    vector<str> names = fs.list_directory_vector(root)
    print("目录列表：", names)
    print("递归列表：", fs.walk_directory(root))
    print("规范路径：", path.normalize("a/./b/../c.txt"))
    print("绝对路径：", path.is_absolute(path.absolute(root)))
    print("相对路径：", path.relative(path.absolute(moved), path.absolute(root)))
    print("替换扩展名：", path.replace_extension(moved, "log"))
    print("删除文件：", fs.remove(source))
    print("递归删除数量：", fs.remove_all(root))
    return !fs.exists(root)
}

def main() -> int
{
    int count = 0
    float ratio = 1.5
    bool ready = true
    str heading = "语法示例"
    auto inferred = 2
    array values = [1, 2.5, "三", true, none]
    array[4] padded = [1, 2]
    array[2] empty_slots
    array empty_array = []
    dict settings = {"status": "完成", "count": 2, 7: false}
    dict empty_dict = {}
    auto user = record(name="Ada", scores=[8.5, 9.0], meta={"active": true})
    auto position = vector2(2, 3) + vector2(4, 5)
    position += vector2(1, 1)
    array nested = [[1, 2], user]
    class_demo()

    # 数组和字典都能按索引读写；结构体字段可赋值。
    values[0] = 3
    settings[7] = true
    settings["new"] = [1, 2]
    user.name = "Grace"
    user.scores[1] = 9.5
    # 元素静态类型为 any；明确的目标类型按 as 的规则转换。
    int first_number = values[0]
    float second_number = values[1]
    str third_text = values[2]
    int saved_count = settings["count"]
    str saved_status = settings["status"]
    print(first_number, second_number, third_text, saved_count, saved_status)
    print()
    print("用户", user.name, "资料", user, sep=" | ")
    print("列表：", nested, end="\n")
    print(user.name + "：" + heading)
    print(user.scores[1])
    print(user.meta["active"])
    print(position.x, position.y)
    print(-position)
    print(position == vector2(7, 9))
    print(len(nested[0]))
    print(nested[1].name)
    print(len(values))
    print(len(settings))
    # 字典查询可允许缺键；contains 能区分缺键和存储的 none。
    any missing = dictionary.get(settings, "missing")
    print(is_none(missing))
    print(dictionary.contains(settings, "status"))
    str found_status = dictionary.get(settings, "status")
    print(found_status)
    print(dictionary.remove(settings, "new"))
    print(dictionary.remove(settings, "new"))
    # 字典无序；两次独立取得的键和值快照不用于按位置配对。
    print(dictionary.keys(settings))
    print(dictionary.values(settings))
    dict scratch = {"temporary": 1}
    dictionary.clear(scratch)
    print(len(scratch))
    print(len(empty_array) + len(empty_dict))
    print(len(heading))
    print(is_none(padded[3]))
    print(is_none(empty_slots[0]))

    # 新名称被绑定为 any；已有变量保持原来的静态类型。
    left, right = [10, 20]
    print(left)
    count, inferred = [3, 4]
    print(count + inferred)

    # 复合赋值是独立语句；后置更新先修改目标，再返回新值。
    int steps = 2
    steps += 3
    steps -= 1
    print(steps++ * 2)
    print(steps--)
    print(steps)
    ratio -= 0.5
    ratio++
    ratio--

    if ready && count > 0
    {
        print((ratio * 2.0) as str)
    }
    else if ready
    {
        print("已就绪，但计数不大于零")
    }
    else
    {
        print("未就绪")
    }
    if !ready || count == 0
    {
        print("不会输出")
    }
    if count >= 3 && count != 0 && count <= 3
    {
        print(8 / 2)
        print(7 % 3)
        print(7 - 2)
        print(-count)
        print(ratio / 0.5)
    }
    if false
    {
        # 保留 input 的调用示例，执行时不会等待终端输入。
        str answer = input("请输入：")
        print(answer)
        auto optional_answer = input_or_none("再输入一行：")
        if !is_none(optional_answer)
        {
            print(optional_answer as str)
        }
        str escaped = "第一行\\n第二行"
        print(escaped)
    }
    while count < 5
    {
        count += 1
    }
    for value in values
    {
        print(value)
    }
    # 字典遍历使用进入循环时的无序键快照。
    for key in settings
    {
        print(key)
    }

    print(sum_to(10))
    print(sum_to(*[10]))
    print(sum_to(**{"n": 10}))
    print(factorial(5))
    print(describe(3))
    print(describe(3.5))
    print(to_float(count))
    print(2 as float)
    print("2.5" as float)
    print(1e2 / 4.0)
    print(3.75 as int)
    print(left as int)
    print("42" as int)
    print(add(1, 2))
    print(math.twice(2.5))
    print(math.twice(value=3))
    // 双斜杠也是单行注释。

    # 位置实参、命名实参、数组和字典展开可组合使用。
    show("展开", *[1, 2], **{"status": "完成"})
    print(count_extra(1, 2, note="额外命名参数"))
    container_library_demo()
    typed_container_demo()
    algorithm_demo()
    parse_error_demo()
    if !filesystem_library_demo()
    {
        return 1
    }
    write_message(message="结束")
    stop_early(true)
    return 0
}
