}

def run_session_kwargs(client: api.session, method: str, url: str,
                       kwargs: dict) -> api.response
{
    api.request_options configured = named.apply(session_options(client), kwargs)
    return execute(method, url, merge_session(client, configured), client, true)
}

def bridge_session_request(client: api.session, method: str, url: str,
                           params: dict = none, data: any = none,
                           headers: dict = none, cookies: dict = none,
                           files: any = none, auth: array = none,
                           timeout: any = none,
                           allow_redirects: bool = none,
                           proxies: any = none, hooks: any = none,
                            stream: bool = none, verify: any = none,
                           cert: any = none, json: any = none,
                           **kwargs: dict) -> api.response
{
    dict supplied = named.collect_request(
        params, data, headers, cookies, files, auth, timeout,
        allow_redirects, proxies, hooks, stream, verify, cert, json, kwargs)
    return run_session_kwargs(client, method, url, supplied)
}

def bridge_session_request(client: api.session, method: str, url: str,
                           options: api.request_options) -> api.response
{
    return execute(method, url, merge_session(client, options), client, true)
}

def bridge_session_get(client: api.session, url: str,
                       **kwargs: dict) -> api.response
{
    return run_session_kwargs(client, "GET", url, kwargs)
}

def bridge_session_get(client: api.session, url: str,
                       options: api.request_options) -> api.response
{
    return bridge_session_request(client, "GET", url, options)
