def bridge_head(url: str, **kwargs: dict) -> api.response
{
    api.request_options settings = bridge_default_options()
    settings.allow_redirects = false
    settings = named.apply(settings, kwargs)
    return bridge_request("HEAD", url, settings)
}

def bridge_head(url: str, options: api.request_options) -> api.response
{
    return bridge_request("HEAD", url, options)
}

def bridge_options(url: str, **kwargs: dict) -> api.response
{
