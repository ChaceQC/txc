import "requests.txh" as api
import "requests_cookie.tx" as cookie_jar
import "requests_kwargs.tx" as named
import "requests_url.tx" as urls
import "requests_transport.tx" as transport
import "array.txh" as arrays
import "bytes.txh" as byte_values
import "encoding.txh" as encoding
import "error.txh" as errors
import "file_stream.txh" as streams
import "httpx.txh" as httpx
import "json.txh" as json_values
import "string.txh" as strings
import "time.txh" as time

def bridge_default_options() -> api.request_options
{
    return api.request_options(map<str, str>(), map<str, str>(),
                               map<str, str>(), byte_values.empty(), "none",
                               30000, true, 10, false, false, "", "",
                               false, "", "", "", "", "", 8388608, 0, 0)
}

def bridge_with_text(options: api.request_options, body: str) -> api.request_options
{
    api.request_options result = deep_copy(options)
    result.body = encoding.encode(body, "utf-8")
    result.body_type = "raw"
    return result
}

def bridge_with_bytes(options: api.request_options, body: bytes) -> api.request_options
{
    api.request_options result = deep_copy(options)
    result.body = body
    result.body_type = "raw"
    return result
}

def bridge_with_form(options: api.request_options,
                     fields: map<str, str>) -> api.request_options
{
    api.request_options result = deep_copy(options)
    result.body = encoding.encode(urls.encode_fields(fields, true), "utf-8")
    result.body_type = "form"
    return result
}

def bridge_with_json(options: api.request_options, value: dict) -> api.request_options
{
    api.request_options result = deep_copy(options)
    result.body = encoding.encode(json_values.stringify(value), "utf-8")
    result.body_type = "json"
    return result
}

def bridge_with_json(options: api.request_options, value: array) -> api.request_options
{
    api.request_options result = deep_copy(options)
    result.body = encoding.encode(json_values.stringify(value), "utf-8")
    result.body_type = "json"
    return result
}

def bridge_session_init(client: api.session) -> void
{
    client.headers = map<str, str>()
    client.cookies = []
    client.timeout_ms = 30000
    client.allow_redirects = true
    client.max_redirects = 10
    client.http2 = false
    client.basic_auth = false
    client.auth_user = ""
    client.auth_password = ""
    client.transport = httpx.client_session(0)
    client.transport_key = ""
    client.closed = false
}

def bridge_session_close(client: api.session) -> void
{
    transport.close_session(client)
}

def session_options(client: api.session) -> api.request_options
{
    api.request_options result = bridge_default_options()
    result.headers = deep_copy(client.headers)
    result.timeout_ms = client.timeout_ms
    result.allow_redirects = client.allow_redirects
    result.max_redirects = client.max_redirects
    result.http2 = client.http2
    result.basic_auth = client.basic_auth
    result.auth_user = client.auth_user
    result.auth_password = client.auth_password
    return result
}

def merge_session(client: api.session,
                  options: api.request_options) -> api.request_options
{
    api.request_options result = deep_copy(options)
    map<str, str> headers = map<str, str>()
    for key in client.headers
    {
        headers[strings.lower(key)] = client.headers[key]
    }
    for key in options.headers
    {
        headers[strings.lower(key)] = options.headers[key]
    }
    result.headers = headers
    if !result.basic_auth && client.basic_auth
    {
        result.basic_auth = true
        result.auth_user = client.auth_user
        result.auth_password = client.auth_password
    }
    return result
}

def cookie_header(values: map<str, str>) -> str
{
    vector<str> parts = vector<str>()
    parts.reserve(values.size())
    for key in values
    {
        parts.push_back(key + "=" + values[key])
    }
    return strings.join(parts, "; ")
}

def request_headers(options: api.request_options, url: str, jar: array,
                    allow_auth: bool, allow_explicit_cookies: bool) -> map<str, str>
{
    map<str, str> result = map<str, str>()
    for key in options.headers
    {
        str normalized = strings.lower(key)
        if ((normalized != "authorization" || allow_auth) &&
            (normalized != "cookie" || allow_explicit_cookies))
        {
            if result.contains(normalized)
            {
                errors.fail_io("invalid_header", "请求头名称大小写重复：" + key)
            }
            result[normalized] = options.headers[key]
        }
    }
    if options.body_type == "form" && !result.contains("content-type")
    {
        result["content-type"] = "application/x-www-form-urlencoded"
    }
    if options.body_type == "json" && !result.contains("content-type")
    {
        result["content-type"] = "application/json; charset=utf-8"
    }
    if options.basic_auth && allow_auth
    {
        str credentials = options.auth_user + ":" + options.auth_password
        result["authorization"] = ("Basic " +
            byte_values.to_base64(encoding.encode(credentials, "utf-8")))
    }
    map<str, str> selected = cookie_jar.for_url(jar, url)
    if allow_explicit_cookies
    {
        for key in options.cookies
        {
            selected[key] = options.cookies[key]
        }
    }
    if !result.contains("cookie") && !selected.empty()
    {
        result["cookie"] = cookie_header(selected)
    }
    return result
}

def redirect_status(status: int) -> bool
{
    return (status == 301 || status == 302 || status == 303 ||
            status == 307 || status == 308)
}

def redirected_method(method: str, status: int) -> str
{
    if status == 303 && method != "HEAD"
    {
        return "GET"
    }
    if (status == 301 || status == 302) && method == "POST"
    {
        return "GET"
    }
    return method
}

def strip_entity_headers(source: api.request_options) -> api.request_options
{
    api.request_options result = deep_copy(source)
    result.body = byte_values.empty()
    result.body_type = "none"
    map<str, str> headers = map<str, str>()
    for key in result.headers
    {
        str normalized = strings.lower(key)
        if (normalized != "content-type" && normalized != "content-encoding" &&
            normalized != "content-length" && normalized != "transfer-encoding")
        {
            headers[key] = result.headers[key]
        }
    }
    result.headers = headers
    return result
}

def retryable_method(method: str) -> bool
{
    return (method == "GET" || method == "HEAD" || method == "OPTIONS" ||
            method == "PUT" || method == "DELETE")
}

def retryable_error(code: str) -> bool
{
    return (code == "timeout" || code == "connection_closed" ||
            code == "operation_failed")
}

def send_with_retry(client: api.session, method: str, url: str,
                    headers: map<str, str>, options: api.request_options) -> api.response
{
    int attempt = 0
    while true
    {
        try
        {
            return transport.send_once(client, method, url, headers,
                                       options.body, options)
        }
        exception errors.io_error as failure
        {
            if (attempt >= options.max_retries ||
                !retryable_method(method) || !retryable_error(failure.code))
            {
                errors.fail_io(failure.code, failure.message)
            }
            attempt++
            if options.retry_backoff_ms > 0
            {
                time.sleep_millis(options.retry_backoff_ms * attempt)
            }
        }
    }
    return api.response()
}

def execute(method: str, url: str, options: api.request_options,
            client: api.session, save_cookies: bool) -> api.response
{
    if options.max_redirects < 0
    {
        errors.fail_io("invalid_argument", "max_redirects 不能为负数")
    }
    if (options.max_retries < 0 || options.max_retries > 3 ||
        options.retry_backoff_ms < 0 || options.retry_backoff_ms > 1000 ||
        options.max_response_bytes < 0)
    {
        errors.fail_io("invalid_argument", "重试次数、等待时间或正文上限无效")
    }
    if (options.body_type != "none" && options.body_type != "raw" &&
        options.body_type != "form" && options.body_type != "json")
    {
        errors.fail_io("invalid_argument", "未知请求正文类型")
    }
    api.request_options current_options = deep_copy(options)
    str current_url = urls.strip_fragment(
        urls.append_params(url, current_options.params))
    str current_method = strings.upper(method)
    bool allow_auth = true
    bool allow_explicit_cookies = true
    int redirects = 0
    array history = []
    set<str> visited = set<str>()
    visited.insert(urls.strip_fragment(current_url))
    while true
    {
        map<str, str> headers = request_headers(current_options, current_url,
                                                 client.cookies, allow_auth,
                                                 allow_explicit_cookies)
        api.response result = send_with_retry(client, current_method,
            current_url, headers, current_options)
        if save_cookies
        {
            cookie_jar.store_response(client.cookies, result.set_cookie,
                                      current_url)
        }
        if (!current_options.allow_redirects ||
            !redirect_status(result.status_code) ||
            !result.headers.contains("location"))
        {
            result.history = history
            return result
        }
        transport.close_response(result)
        if redirects >= current_options.max_redirects
        {
            errors.fail_io("too_many_redirects", "HTTP 重定向次数超过上限")
        }
        str location = result.headers["location"]
        str next_url = urls.strip_fragment(
            urls.resolve_location(current_url, location))
        if visited.contains(urls.strip_fragment(next_url))
        {
            errors.fail_io("too_many_redirects", "HTTP 重定向出现循环")
        }
        visited.insert(urls.strip_fragment(next_url))
        arrays.push_back(history, result)
        if urls.origin(current_url) != urls.origin(next_url)
        {
            allow_auth = false
            allow_explicit_cookies = false
        }
        if (strings.starts_with(strings.lower(current_url), "https://") &&
            strings.starts_with(strings.lower(next_url), "http://"))
        {
            # TLS 信任和客户端身份只用于 HTTPS；降级后不携带它们。
            current_options.ca_file = ""
            current_options.client_pfx_file = ""
            current_options.client_pfx_password = ""
        }
        str next_method = redirected_method(current_method, result.status_code)
        if next_method != current_method
        {
            current_options = strip_entity_headers(current_options)
        }
        current_method = next_method
        current_url = next_url
        redirects++
    }
    # 循环只会在返回响应或报告错误时结束，补足静态返回路径。
    return api.response()
}

def run_request_named(method: str, url: str, kwargs: dict) -> api.response
{
    api.request_options settings = named.apply(bridge_default_options(), kwargs)
    api.session temporary = api.session()
    try
    {
        api.response result = execute(method, url, settings, temporary, false)
        transport.close_session(temporary)
        return result
    }
    exception errors.io_error as failure
    {
        transport.close_session(temporary)
        errors.fail_io(failure.code, failure.message)
    }
    return api.response()
}

def bridge_request(method: str, url: str, **kwargs: dict) -> api.response
{
    return run_request_named(method, url, kwargs)
}

def bridge_request(method: str, url: str,
                   options: api.request_options) -> api.response
{
    api.session temporary = api.session()
    try
    {
        api.response result = execute(method, url, options, temporary, false)
        transport.close_session(temporary)
        return result
    }
    exception errors.io_error as failure
    {
        transport.close_session(temporary)
        errors.fail_io(failure.code, failure.message)
    }
    return api.response()
}

def bridge_get(url: str, params: dict = none,
               **kwargs: dict) -> api.response
{
    named.add_if_present(kwargs, "params", params)
    return run_request_named("GET", url, kwargs)
}

def bridge_get(url: str, options: api.request_options) -> api.response
{
    return bridge_request("GET", url, options)
}

def bridge_post(url: str, data: any = none, json: any = none,
                **kwargs: dict) -> api.response
{
    named.add_if_present(kwargs, "data", data)
    named.add_if_present(kwargs, "json", json)
    return run_request_named("POST", url, kwargs)
}

def bridge_post(url: str, options: api.request_options) -> api.response
{
    return bridge_request("POST", url, options)
}

