def bridge_session_head(client: api.session, url: str,
                        **kwargs: dict) -> api.response
{
    api.request_options settings = session_options(client)
    settings.allow_redirects = false
    settings = named.apply(settings, kwargs)
    return execute("HEAD", url, merge_session(client, settings), client, true)
}

def bridge_session_options(client: api.session, url: str,
                           options: api.request_options) -> api.response
{
    return bridge_session_request(client, "OPTIONS", url, options)
}

def bridge_session_options(client: api.session, url: str,
                           **kwargs: dict) -> api.response
{
    return run_session_kwargs(client, "OPTIONS", url, kwargs)
}

def bridge_text(value: api.response) -> str
{
    return encoding.decode(value.content, "utf-8")
}

def bridge_text(value: api.response, charset: str) -> str
{
    return encoding.decode(value.content, charset)
}

def bridge_json(value: api.response) -> any
{
    return json_values.parse(bridge_text(value))
}

def bridge_json_object(value: api.response) -> dict
{
    return json_values.parse_object(bridge_text(value))
}

def bridge_raise_for_status(value: api.response) -> void
{
    if value.status_code >= 400 && value.status_code <= 599
    {
        errors.fail_io("http_error", "HTTP 请求失败：" +
                       value.status_code as str)
    }
}

def stream_response(value: httpx.stream_response, url: str,
                    elapsed_ms: int) -> api.response
{
    api.response result = api.response()
    result.status_code = value.status
    result.url = url
    result.headers = value.headers
    result.set_cookie = value.set_cookie
    result.cookies = cookie_jar.response_cookies(value.set_cookie, url)
    result.content = byte_values.empty()
    result.history = []
    result.elapsed_ms = elapsed_ms
    result.ok = value.status < 400
    return result
}

def bridge_download(url: str, destination: binary_stream,
                    max_bytes: int) -> api.response
{
    return bridge_download(url, destination, max_bytes, bridge_default_options())
}

def bridge_download(url: str, destination: binary_stream, max_bytes: int,
                    options: api.request_options) -> api.response
{
    if (!options.headers.empty() || !options.cookies.empty() ||
        options.basic_auth || options.body_type != "none")
    {
        errors.fail_io("unsupported_option", "流式下载暂不支持自定义头、认证或正文")
    }
    str address = urls.strip_fragment(urls.append_params(url, options.params))
    int started = time.monotonic_millis()
    if options.http2
    {
        httpx.stream_response received = httpx.get_http2_stream(
            address, destination, max_bytes, options.timeout_ms)
        return stream_response(received, address,
                               time.monotonic_millis() - started)
    }
    httpx.stream_response received = httpx.get_stream(
        address, destination, max_bytes, options.timeout_ms)
    return stream_response(received, address, time.monotonic_millis() - started)
}

def bridge_upload(method: str, url: str, source: binary_stream, length: int,
                  destination: binary_stream, max_response_bytes: int,
                  options: api.request_options) -> api.response
{
    if options.body_type != "none"
    {
        errors.fail_io("invalid_argument", "流式上传不能同时指定内存正文")
    }
    str address = urls.strip_fragment(urls.append_params(url, options.params))
    map<str, str> headers = request_headers(options, address, [], true, true)
    int started = time.monotonic_millis()
    if options.http2
    {
        httpx.stream_response received = httpx.send_http2_stream(
            method, address, headers, source, length, destination,
            max_response_bytes, options.timeout_ms)
        return stream_response(received, address,
                               time.monotonic_millis() - started)
    }
    httpx.stream_response received = httpx.send_stream(
        method, address, headers, source, length, destination,
        max_response_bytes, options.timeout_ms)
    return stream_response(received, address, time.monotonic_millis() - started)
}
