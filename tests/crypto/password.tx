import "encoding.txh" as encoding
import "error.txh" as errors
import "password.txh" as password
import "secret.txh" as secret

def invalid_phc(value: secret_bytes, encoded: str) -> bool
{
    try
    {
        password.verify_password(value, encoded)
    }
    exception errors.security_error as e
    {
        return e.code == "invalid_format"
    }
    return false
}

def invalid_parameters(value: secret_bytes) -> bool
{
    try
    {
        password.hash_password_with_params(value, 1024, 1, 1)
    }
    exception errors.security_error as e
    {
        return e.code == "invalid_argument"
    }
    return false
}

def main() -> int
{
    secret_bytes phrase = secret.from_bytes(encoding.encode("password", "utf-8"))
    secret_bytes wrong = secret.from_bytes(encoding.encode("wrong", "utf-8"))
    str vector19 = "$argon2id$v=19$m=19456,t=2,p=1$AAECAwQFBgcICQoLDA0ODw$OZA6NM05OHZDbmcc1pDf6Kuc57E0WafgTsDk8GlN2w0"
    str vector16 = "$argon2id$v=16$m=19456,t=2,p=1$AAECAwQFBgcICQoLDA0ODw$VkkR+3Y32H51NoR/rxS1AfLgIBSkwwYzUCKJxxrX04k"
    if !password.verify_password(phrase, vector19) || !password.verify_password(phrase, vector16)
    {
        return 1
    }
    if password.verify_password(wrong, vector19) || !password.needs_rehash(vector16, 19456, 2, 1)
    {
        return 2
    }
    str generated = password.hash_password_with_params(phrase, 19456, 2, 1)
    if !password.verify_password(phrase, generated) || password.needs_rehash(generated, 19456, 2, 1)
    {
        return 3
    }
    if !invalid_phc(phrase, "$argon2id$v=19$m=4294967295,t=10,p=4$AAECAwQFBgcICQoLDA0ODw$OZA6NM05OHZDbmcc1pDf6Kuc57E0WafgTsDk8GlN2w0")
    {
        return 4
    }
    if !invalid_phc(phrase, "bad-phc") || !invalid_parameters(phrase)
    {
        return 5
    }
    secret.close(phrase)
    secret.close(wrong)
    print("PASSWORD_OK")
    return 0
}
