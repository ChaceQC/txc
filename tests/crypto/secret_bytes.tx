import "bytes.txh" as byte_values
import "error.txh" as errors
import "secret.txh" as secret

def closed_alias(value: secret_bytes) -> bool
{
    try
    {
        secret.size(value)
    }
    exception errors.security_error as e
    {
        return e.code == "invalid_state"
    }
    return false
}

def bad_length() -> bool
{
    try
    {
        secret.random(-1)
    }
    exception errors.security_error as e
    {
        return e.code == "size_limit"
    }
    return false
}

def main() -> int
{
    bytes source = byte_values.from_hex("01020304")
    secret_bytes value = secret.from_bytes(source)
    secret_bytes alias = value
    secret_bytes different = secret.from_bytes(byte_values.from_hex("01020305"))
    if secret.size(value) != 4 || secret.to_bytes(value) != source
    {
        return 1
    }
    if !secret.equal(value, alias) || secret.equal(value, different)
    {
        return 2
    }
    secret.close(value)
    if !closed_alias(alias)
    {
        return 3
    }
    secret.close(alias)
    if secret.size(secret.random(0)) != 0 || !bad_length()
    {
        return 4
    }
    print("SECRET_OK")
    return 0
}
