import "dictionary.txh" as dictionary
import "test.txh" as test

def main() -> int
{
    dict values = {1: 1, "two": 2, true: 3}
    int count = 0
    for repetition in 0..=3
    {
        values["two"] = repetition
        for unused in values
        {
            count += 1
        }
    }
    test.assert_equal(12, count)
    dict alias = values
    count = 0
    for key in values
    {
        dictionary.clear(alias)
        count += 1
    }
    test.assert_equal(3, count)
    test.assert_equal(0, len(values))
    values[1] = 1
    values[2] = 2
    count = 0
    for key in values
    {
        values[3] = 3
        count += key as int
    }
    test.assert_equal(3, count)
    print("DICTIONARY_ITERATION_OK")
    return 0
}
