import "graphics.txh" as gfx
import "gui.txh" as gui
import "test.txh" as test
import "error.txh" as errors

struct saved_control
{
    value: gui_text_box
}

def main() -> int
{
    auto app = gfx.open_app().value()
    auto window = gfx.create_window(app, gfx.window_options("GUI 自动验证", 480.0, 300.0, true)).value()
    auto root = gui.root(window).value()
    test.assert_equal(gui.id(root), gui.id(gui.root(window).value()))
    gui.set_column(root, 12.0, 8.0)
    auto group = gui.create_container(root).value()
    gui.set_grid(group, 2, 2, 0.0, 4.0)
    gui.set_grid_column(group, 0, gui.fixed(100.0))
    gui.set_grid_column(group, 1, gui.stretch(1.0))
    auto label = gui.create_label(group, "姓名").value()
    auto input = gui.create_text_box(group, false).value()
    gui.set_cell(input, 0, 1, 1, 1)
    auto button = gui.create_button(group, "提交").value()
    gui.set_cell(button, 1, 0, 1, 2)
    gui.set_height(button, gui.fixed(30.0))
    auto check = gui.create_check_box(root, "通知", false).value()
    auto tri = gui.create_check_box(root, "继承", true).value()
    gui.set_checked(check, true)
    test.assert_true(gui.checked(check))
    gui.set_check_state(tri, "mixed")
    test.assert_equal("mixed", gui.check_state(tri))
    gui.set_text(input, "甲😀é")
    gui.set_selection(input, 1, 2)
    test.assert_equal(1, gui.selection_start(input))
    test.assert_equal(2, gui.selection_end(input))
    gui.set_width(label, gui.auto_length())
    gui.set_alignment(label, "start", "center")
    gui.set_constraints(input, 40.0, 20.0, 500.0, 60.0)
    gui.set_margin(button, 2.0)
    gui.set_visible(tri, false)
    gui.set_reserved_space(tri, true)
    gui.set_enabled(check, false)
    gui.set_password(input, true)
    gui.set_read_only(input, true)
    gui.set_text_limit(input, 16)
    gui.flush_layout(window)
    vector<gui_text_box> controls = vector<gui_text_box>(2, input)
    auto saved = saved_control(controls[1])
    array resources = [input]
    any dynamic = resources[0]
    auto alias = dynamic as gui_text_box
    test.assert_equal(gui.id(input), gui.id(alias))
    try
    {
        auto wrong = dynamic as gui_button
        test.assert_true(false, "any 必须保留具体 GUI 类型")
    }
    exception errors.runtime_error as e
    {
        test.assert_true(true)
    }
    try
    {
        auto copy = deep_copy([input])
        test.assert_true(false, "深拷贝必须拒绝 GUI")
    }
    exception errors.graphics_error as e
    {
        test.assert_equal("invalid_argument", e.code)
    }
    try
    {
        gui.set_grid(group, 1, 1, 0.0, 0.0)
        test.assert_true(false, "缩小网格必须检查子项")
    }
    exception errors.graphics_error as e
    {
        test.assert_equal("invalid_layout", e.code)
    }
    gui.flush_layout(window)
    bool draining = true
    while draining
    {
        auto event = gfx.next_event(app, 0).value()
        if event.is_none()
        {
            draining = false
        }
        else
        {
            test.assert_true(event.value().control.is_none(), "setter 不发送操作事件")
        }
    }
    gui.close(group)
    test.assert_false(gui.is_open(saved.value))
    test.assert_false(gui.is_open(alias))
    gui.close(input)
    test.assert_equal("closed_resource", gui.focus(input).error().code)
    test.assert_true(gui.is_open(check))
    gfx.close(window)
    test.assert_false(gui.is_open(check))
    gfx.close(app)
    print("gui U0-U1 behavior: PASS")
    return 0
}
