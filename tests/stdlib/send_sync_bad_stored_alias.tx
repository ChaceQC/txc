import "thread.txh" as thread

struct point
{
    value: int
}

def read(points: vector<point>) -> int
{
    return points[0].value
}

def main() -> int
{
    point current = point(5)
    vector<point> points = vector<point>()
    points.push_back(current)
    join_handle<int> worker = thread.spawn(bind(read, move(points)))
    return thread.join(worker)
}
