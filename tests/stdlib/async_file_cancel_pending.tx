import "task.txh" as task
import "async_file.txh" as async_file
import "ipc.txh" as ipc
import "cancel.txh" as cancel

def run(scope: task_scope) -> int
{
    ipc_listener server = ipc.listen("tx_async_cancel_pending", 32)
    cancel_source source = cancel.source()
    task<async_file.read_result> pending = async_file.read_at(
        "\\\\.\\pipe\\tx-ipc-tx_async_cancel_pending", 0, 8,
        cancel.token(source))
    cancel.cancel(source)
    async_file.read_result outcome = task.wait(pending)
    ipc.close_listener(server)
    if !outcome.cancelled || outcome.error_code != "" || len(outcome.data) != 0
    {
        return 1
    }
    return 0
}

def main() -> int
{
    return task.scope(run, 2, 5000)
}
