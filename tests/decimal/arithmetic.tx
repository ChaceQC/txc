import "decimal.txh" as decimal
import "error.txh" as errors

def zero_division_is_rejected() -> bool
{
    try
    {
        decimal.div(decimal.from_int(1), decimal.from_int(0), 2,
                    "half_even")
    }
    exception errors.runtime_error as e
    {
        return e.code == "division_by_zero"
    }
    return false
}

def precision_is_checked() -> bool
{
    try
    {
        decimal.parse("100000000000000000000000000000000000000")
    }
    exception errors.parse_error as e
    {
        return e.code == "out_of_range"
    }
    return false
}

def invalid_text_is_rejected() -> bool
{
    try
    {
        decimal.parse("1e-2")
    }
    exception errors.parse_error as e
    {
        return e.code == "invalid_syntax"
    }
    return false
}

def arithmetic_overflow_is_rejected() -> bool
{
    try
    {
        decimal.mul(decimal.parse("99999999999999999999999999999999999999"),
                    decimal.from_int(10), 0, "toward_zero")
    }
    exception errors.runtime_error as e
    {
        return e.code == "out_of_range"
    }
    return false
}

def invalid_scale_is_rejected() -> bool
{
    try
    {
        decimal.quantize(decimal.from_int(1), 19, "half_even")
    }
    exception errors.runtime_error as e
    {
        return e.code == "invalid_argument"
    }
    return false
}

def invalid_mode_is_rejected() -> bool
{
    try
    {
        decimal.quantize(decimal.from_int(1), 2, "other")
    }
    exception errors.runtime_error as e
    {
        return e.code == "invalid_argument"
    }
    return false
}

def main() -> int
{
    decimal.decimal first = decimal.parse("0.1")
    decimal.decimal second = decimal.parse("0.2")
    if decimal.to_text(decimal.add(first, second, 1, "half_even")) != "0.3"
    {
        return 1
    }
    decimal.decimal amount = decimal.parse("+00012.3400")
    if (decimal.to_text(amount) != "12.3400" || decimal.scale(amount) != 4 ||
        decimal.compare(amount, decimal.parse("12.34")) != 0)
    {
        return 2
    }
    if (decimal.to_text(decimal.quantize(decimal.parse("2.5"), 0,
                                         "half_even")) != "2" ||
        decimal.to_text(decimal.quantize(decimal.parse("3.5"), 0,
                                         "half_even")) != "4" ||
        decimal.to_text(decimal.quantize(decimal.parse("-2.5"), 0,
                                         "half_away")) != "-3")
    {
        return 3
    }
    if (decimal.to_text(decimal.sub(decimal.parse("1.00"),
                                    decimal.parse("0.125"), 3,
                                    "half_even")) != "0.875" ||
        decimal.to_text(decimal.mul(decimal.parse("1.25"),
                                    decimal.parse("0.8"), 2,
                                    "half_even")) != "1.00")
    {
        return 4
    }
    if (decimal.to_text(decimal.div(decimal.from_int(1),
                                    decimal.from_int(3), 2,
                                    "half_even")) != "0.33" ||
        decimal.to_text(decimal.div(decimal.from_int(-1),
                                    decimal.from_int(8), 2,
                                    "half_away")) != "-0.13" ||
        decimal.to_text(decimal.div(decimal.from_int(-1),
                                    decimal.from_int(8), 2,
                                    "half_even")) != "-0.12")
    {
        return 5
    }
    if (decimal.to_text(decimal.mul(
        decimal.parse("9999999999999999999.9"),
        decimal.parse("9999999999999999999.9"), 0, "toward_zero")) !=
        "99999999999999999998000000000000000000")
    {
        return 6
    }
    decimal.decimal copied = deep_copy(amount)
    if (decimal.to_text(copied) != decimal.to_text(amount) ||
        decimal.compare(decimal.from_int(-1), decimal.from_int(0)) != -1 ||
        decimal.to_text(decimal.parse("-0.00")) != "0.00")
    {
        return 7
    }
    if !(zero_division_is_rejected() && precision_is_checked() &&
         invalid_text_is_rejected() && arithmetic_overflow_is_rejected() &&
         invalid_scale_is_rejected() && invalid_mode_is_rejected())
    {
        return 8
    }
    if (decimal.to_text(decimal.quantize(decimal.parse("-1.21"), 1,
                                         "floor")) != "-1.3" ||
        decimal.to_text(decimal.quantize(decimal.parse("-1.21"), 1,
                                         "ceiling")) != "-1.2")
    {
        return 9
    }
    return 0
}
