import "error.txh" as errors

def expect(condition: bool, label: str)
{
    if !condition
    {
        print("FAIL", label)
        print(1 / 0)
    }
}

def rejecting(left: int, right: int) -> int
{
    if left == 13 || right == 13
    {
        return 1 / 0
    }
    return left - right
}

def read_while_comparing(holder: array, left: int, right: int) -> int
{
    auto values = holder[0] as heap<int>
    print(values.top())
    return left - right
}

def main() -> int
{
    auto source = vector<int>([4, 1, 3])
    auto queue_values = queue<int>(source)
    source.push_back(9)
    expect(queue_values.to_vector().size() == 3, "queue batch snapshot")
    expect(queue_values.front() == 4 && queue_values.back() == 3, "queue order")
    queue_values.pop()
    expect(queue_values.front() == 1, "queue pop")

    auto heap_values = heap<int>(source)
    expect(heap_values.top() == 1, "heap batch")
    auto shared = heap_values
    heap_values.push(0)
    expect(shared.top() == 0, "heap alias")
    auto copied = deep_copy(heap_values)
    copied.pop()
    expect(heap_values.top() == 0 && copied.top() == 1, "heap deep copy")

    auto entries = vector<priority_entry<str>>()
    entries.push_back(priority_entry<str>(2, "first"))
    entries.push_back(priority_entry<str>(1, "early"))
    entries.push_back(priority_entry<str>(2, "second"))
    auto stable = heap<priority_entry<str>>(entries)
    stable.push(priority_entry<str>(2, "third"))
    auto ordered = stable.to_vector()
    expect(ordered[0].value == "early" && ordered[1].value == "first" && ordered[2].value == "second" && ordered[3].value == "third", "stable priority")
    auto descending = heap<priority_entry<str>>(true, entries)
    expect(descending.top().value == "first", "descending stable priority")

    auto guarded = heap<int>(rejecting)
    guarded.push(1)
    bool caught = false
    try
    {
        guarded.push(13)
    }
    exception errors.runtime_error as e
    {
        caught = true
    }
    expect(caught && guarded.size() == 1 && guarded.top() == 1, "failed push preserves heap")

    caught = false
    try
    {
        auto bad = heap<int>(vector<int>([1, 13]), rejecting)
    }
    exception errors.runtime_error as e
    {
        caught = true
    }
    expect(caught, "failed batch build")

    array holder = [heap<int>()]
    fn(int, int)->int compare = bind(read_while_comparing, holder)
    auto checked = heap<int>(compare)
    holder[0] = checked
    checked.push(1)
    caught = false
    try
    {
        checked.push(2)
    }
    exception errors.runtime_error as e
    {
        caught = true
    }
    expect(caught && checked.size() == 1, "comparator reentry")

    auto empty_heap = heap<int>()
    caught = false
    try
    {
        empty_heap.pop()
    }
    exception errors.runtime_error as e
    {
        caught = true
    }
    expect(caught, "empty heap")

    auto empty_queue = queue<int>()
    caught = false
    try
    {
        empty_queue.front()
    }
    exception errors.runtime_error as e
    {
        caught = true
    }
    expect(caught, "empty queue")

    auto infinity = 1e308 * 1e308
    auto nan = infinity - infinity
    caught = false
    try
    {
        heap<float>(vector<float>([1.0, nan]))
    }
    exception errors.runtime_error as e
    {
        caught = true
    }
    expect(caught, "NaN rejected")
    print("sequence extended ok")
    return 0
}
