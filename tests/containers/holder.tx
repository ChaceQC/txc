def make() -> holder
{
    auto values = map<int, str>()
    values[7] = "original"
    return holder(values, values)
}

def replace(values: holder, order: vector<int>) -> int
{
    order.push_back(1)
    values.first = map<int, str>()
    values.first[7] = "new"
    return 7
}

def grow(values: map<int, str>, order: vector<int>) -> str
{
    order.push_back(2)
    for key in 100..=227
    {
        values[key] = "filled"
    }
    return "changed"
}

def pass_queue(values: queue<str>) -> queue<str>
{
    return values
}
