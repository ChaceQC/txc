import "httpx.txh" as httpx

def main() -> int
{
    httpx.listener server = httpx.listen_h2c("127.0.0.1", 19741)
    int i = 0
    while i < 2
    {
        httpx.request request = httpx.accept(server, 15000)
        httpx.respond(request.connection,
            httpx.response(200, map<str, str>(), vector<str>(), request.target))
        i = i + 1
    }
    httpx.close(server)
    return 0
}
