import "websocket.txh" as ws

def echo(text: str) -> str
{
    return text + "!"
}

def empty_reply(text: str) -> str
{
    return text
}

def main() -> int
{
    ws.listener server = ws.listen("127.0.0.1", 19732)
    ws.connection peer = ws.accept(server, 10000)
    if !ws.reply_once(peer, echo, 10000)
    {
        return 1
    }
    if !ws.reply_once(peer, empty_reply, 10000)
    {
        return 2
    }
    ws.close(peer)
    ws.close(server)
    return 0
}
