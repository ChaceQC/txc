import "httpx.txh" as httpx
import "system.txh" as system
import "error.txh" as errors

def main() -> int
{
    vector<str> args = system.args()
    if args[0] == "system"
    {
        httpx.negotiated_response response = httpx.send_negotiated("GET",
            "http://127.0.0.1:19753/check", map<str, str>(), "", 5000,
            "system")
        if response.protocol != "http/1.1" || response.status != 200 || response.body != "/check"
        {
            return 1
        }
        bool rejected = false
        try
        {
            httpx.send_negotiated("POST", "https://127.0.0.1:19753/",
                map<str, str>(), "body", 1000, "h3_then_h2")
        }
        exception errors.io_error as failure
        {
            rejected = failure.code == "replay_unsafe"
        }
        if !rejected
        {
            return 2
        }
    }
    else
    {
        httpx.negotiated_response response = httpx.send_negotiated("POST",
            "http://127.0.0.1:19738/echo", map<str, str>(), "h2", 5000,
            "h2_only")
        if response.protocol != "h2" || response.status != 201 || response.body != "h2"
        {
            return 3
        }
    }
    return 0
}
