import "cancel.txh" as cancel
import "error.txh" as errors
import "socket.txh" as net
import "task.txh" as task

def fill(scope: task_scope) -> int
{
    net.tcp_listener listener = net.listen_tcp("127.0.0.1", 0, 2)
    cancel_source source = cancel.source()
    int index = 0
    while index < 1024
    {
        net.accept_async(listener, 30000, cancel.token(source))
        index = index + 1
    }
    net.accept_async(listener, 30000, cancel.token(source))
    return 1
}

def main() -> int
{
    try
    {
        task.scope(fill, 1100, 10000)
    }
    exception errors.io_error as failure
    {
        if failure.code == "network_queue_full"
        {
            return 0
        }
    }
    return 1
}
