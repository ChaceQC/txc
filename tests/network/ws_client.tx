import "websocket.txh" as ws

def main() -> int
{
    ws.connection peer = ws.connect("ws://127.0.0.1:19732/", 5000)
    ws.send_text(peer, "你好")
    ws.message first = ws.receive(peer, 5000)
    if !first.open || first.text != "你好!"
    {
        return 1
    }
    ws.send_text(peer, "")
    ws.message second = ws.receive(peer, 5000)
    if !second.open || second.text != ""
    {
        return 2
    }
    ws.close(peer)
    return 0
}
