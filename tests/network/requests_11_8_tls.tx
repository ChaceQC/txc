import "error.txh" as errors
import "requests.txh" as requests
import "system.txh" as system

def main() -> int
{
    vector<str> args = system.args()
    str url = args[0]
    str root = args[1]
    str unrelated = args[2]
    str package = args[3]
    str system_url = args[4]

    auto client = requests.session()
    auto system_response = client.get(system_url, timeout=10)
    if system_response.status_code < 200 || system_response.status_code >= 400
    {
        return 1
    }

    bool custom_root_rejected = false
    try
    {
        client.get(url, verify=root, cert=[package, "test-only-password"])
    }
    exception errors.io_error as failure
    {
        custom_root_rejected = failure.code == "security_error"
    }
    if !custom_root_rejected
    {
        return 2
    }

    // 同一会话更换 CA 后必须销毁旧池，并在请求发送前拒绝新配置。
    bool rebuilt_pool_rejected = false
    try
    {
        client.get(url, verify=unrelated,
                   cert=[package, "test-only-password"])
    }
    exception errors.io_error as failure
    {
        rebuilt_pool_rejected = failure.code == "security_error"
    }
    if !rebuilt_pool_rejected
    {
        return 3
    }
    client.close()

    bool direct_custom_root_rejected = false
    try
    {
        requests.get(url, verify=root, cert=[package, "test-only-password"])
    }
    exception errors.io_error as failure
    {
        direct_custom_root_rejected = failure.code == "security_error"
    }
    if !direct_custom_root_rejected
    {
        return 4
    }

    bool system_trust_rejects_untrusted_server = false
    try
    {
        requests.get(url, cert=[package, "test-only-password"])
    }
    exception errors.io_error as failure
    {
        system_trust_rejects_untrusted_server = failure.code == "security_error"
    }
    if !system_trust_rejects_untrusted_server
    {
        return 5
    }

    bool disabled_rejected = false
    try
    {
        requests.get(url, verify=false)
    }
    exception errors.io_error as failure
    {
        disabled_rejected = failure.code == "unsupported_option"
    }
    if !disabled_rejected
    {
        return 6
    }
    return 0
}
