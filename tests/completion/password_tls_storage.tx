import "secret.txh" as secret
import "password.txh" as password
import "x509.txh" as x509
import "tls.txh" as tls
import "socket.txh" as socket
import "crypto.txh" as crypto
import "encoding.txh" as encoding
import "bytes.txh" as bytes
import "file.txh" as file
import "parse.txh" as parse
import "system.txh" as system
import "test.txh" as test

def main() -> int
{
    auto args = system.args()
    auto directory = args[0]
    auto phrase = secret.from_bytes(encoding.encode("test-only-password", "utf-8"))
    auto stored = password.hash_password(phrase)
    test.assert_true(password.verify_password(phrase, stored))
    auto certificates = x509.parse_pkcs12(file.read_bytes(directory + "/client.p12"), phrase)
    test.assert_true(len(certificates) > 0)
    auto identity = tls.import_identity(file.read_bytes(directory + "/client.p12"), phrase)
    secret.close(phrase)
    auto root = x509.parse_der(file.read_bytes(directory + "/root.der"))
    auto config = tls.with_client_identity(tls.client("service.example",
        tls.custom_trust(vector<bytes>([root]), false)), identity)
    auto plain = socket.connect_tcp("127.0.0.1", parse.parse_int(args[1]), 5000)
    auto peer = tls.connect(plain, config, vector<str>(["tx-test"]), 5000)
    tls.close_identity(identity)
    tls.write(peer, bytes.from_hex("00ff80"), 5000)
    auto response = tls.read(peer, 8, 5000)
    test.assert_equal("01020304", bytes.to_hex(response.data))
    tls.close(peer, 5000)
    auto key = secret.random(32)
    auto path = directory + "/received.bin"
    file.write_bytes(path, response.data)
    crypto.encrypt_file(key, path, directory + "/stored.txcf", bytes.empty(), "key-v1")
    crypto.decrypt_file(key, directory + "/stored.txcf", directory + "/restored.bin", bytes.empty(), "key-v1")
    test.assert_true(crypto.secure_equal(response.data, file.read_bytes(directory + "/restored.bin")))
    secret.close(key)
    return 0
}
